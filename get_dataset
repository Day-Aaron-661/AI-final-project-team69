def sanitize_for_url(text):
    return urllib.parse.quote(text)

def get_lyrics_ovh(artists, name):
    encoded_artists = sanitize_for_url(artists)
    encoded_name = sanitize_for_url(name)
    url = f"https://api.lyrics.ovh/v1/{encoded_artists}/{encoded_name}"
    response = requests.get(url)
    if response.status_code == 200:
        lyric = response.json().get("lyrics", "")
        return lyric
    else:
        return None

def get_song_name_artist(track_id):
    track = sp.track(track_id)
    name = track["name"]
    artist = track["artists"][0]["name"]
    return f"{name} {artist}"

